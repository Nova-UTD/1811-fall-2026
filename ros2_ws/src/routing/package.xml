<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>routing</name>
  <version>0.0.0</version>
  <description>Teach-and-repeat route recording: route_recorder_node subscribes
    /odometry during TEACH and writes a downsampled CSV waypoint file. See
    docs/teach_and_repeat_guide.md (Stage A1) for the interface contract.</description>
  <maintainer email="k28adit@gmail.com">adit22</maintainer>
  <license>TODO: License declaration</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_srvs</depend>

  <!-- test-only: test_route_recorder_core.py round-trips a recorded file
       through control.pure_pursuit_core.load_csv_path to verify the two
       packages actually agree on the CSV format, not just by convention. -->
  <test_depend>control</test_depend>
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
