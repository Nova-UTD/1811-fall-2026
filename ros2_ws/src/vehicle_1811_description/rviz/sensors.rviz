Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Plane Cell Count: 20
      Color: 160; 160; 164
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Topic:
        Value: /robot_description
      Visual Enabled: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Show Names: true
      Marker Scale: 0.3
    # Original sensor clouds use larger colored points for comparison.
    - Class: rviz_default_plugins/PointCloud2
      Name: Lidar
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /ouster/points
      Style: Points
      Size (Pixels): 4
      Color Transformer: FlatColor
      Color: 240; 50; 50
      Decay Time: 0
    - Class: rviz_default_plugins/PointCloud2
      Name: ZED front cloud
      Enabled: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /zed_front/zed_node/point_cloud/cloud_registered
      Style: Points
      Size (Pixels): 4
      Color Transformer: FlatColor
      Color: 40; 160; 255
      Decay Time: 0
    - Class: rviz_default_plugins/PointCloud2
      Name: ZED left cloud
      Enabled: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /zed_left/zed_node/point_cloud/cloud_registered
      Style: Points
      Size (Pixels): 4
      Color Transformer: FlatColor
      Color: 50; 220; 80
      Decay Time: 0
    - Class: rviz_default_plugins/PointCloud2
      Name: ZED rear cloud
      Enabled: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /zed_rear/zed_node/point_cloud/cloud_registered
      Style: Points
      Size (Pixels): 4
      Color Transformer: FlatColor
      Color: 255; 160; 40
      Decay Time: 0
    - Class: rviz_default_plugins/PointCloud2
      Name: ZED right cloud
      Enabled: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /zed_right/zed_node/point_cloud/cloud_registered
      Style: Points
      Size (Pixels): 4
      Color Transformer: FlatColor
      Color: 240; 70; 210
      Decay Time: 0
    # RGB8 shows each sensor's color in the merged result, including LiDAR.
    - Class: rviz_default_plugins/PointCloud2
      Name: Registered LiDAR and ZED
      Enabled: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /lidar_perception/registered_points
      Style: Points
      Size (Pixels): 2
      Color Transformer: RGB8
      Decay Time: 0
    # Lidar images (os_driver publishes them with the cloud). Signal and range
    # are on; tick reflectivity / near-IR in the Displays panel if needed.
    - Class: rviz_default_plugins/Image
      Name: Lidar signal
      Enabled: true
      Normalize Range: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /ouster/signal_image
    - Class: rviz_default_plugins/Image
      Name: Lidar range
      Enabled: true
      Normalize Range: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /ouster/range_image
    - Class: rviz_default_plugins/Image
      Name: Lidar reflectivity
      Enabled: false
      Normalize Range: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /ouster/reflec_image
    - Class: rviz_default_plugins/Image
      Name: Lidar near-IR
      Enabled: false
      Normalize Range: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /ouster/nearir_image
    # Cameras (Jetson, over the cable). jetson_bringup zed_cameras.launch.py.
    # Best effort so a slow link drops frames instead of backing up.
    - Class: rviz_default_plugins/Image
      Name: Front camera
      Enabled: true
      Normalize Range: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /zed_front/zed_node/rgb/color/rect/image
    - Class: rviz_default_plugins/Image
      Name: Left camera
      Enabled: true
      Normalize Range: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /zed_left/zed_node/rgb/color/rect/image
    - Class: rviz_default_plugins/Image
      Name: Rear camera
      Enabled: true
      Normalize Range: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /zed_rear/zed_node/rgb/color/rect/image
    - Class: rviz_default_plugins/Image
      Name: Right camera
      Enabled: true
      Normalize Range: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /zed_right/zed_node/rgb/color/rect/image
    # The panorama is independent of point-cloud registration.
    - Class: rviz_default_plugins/Image
      Name: Panorama
      Enabled: true
      Normalize Range: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /panorama/image
  Global Options:
    # Keep the raw LiDAR cloud in its own frame, without applying the
    # measured base_link-to-LiDAR mounting pitch to the RViz view.
    # The URDF and TF still keep that measurement for the vehicle.
    Fixed Frame: os_lidar
    Background Color: 118; 118; 118
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 12
      Pitch: 0.7
      Yaw: 2.4
      Focal Point:
        X: 0.3
        Y: 0
        Z: 0.3
Window Geometry:
  Height: 1000
  Width: 1600
