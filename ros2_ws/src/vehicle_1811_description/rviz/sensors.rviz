Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Plane Cell Count: 20
      Color: 160; 160; 164
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Topic:
        Value: /robot_description
      Visual Enabled: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Show Names: true
      Marker Scale: 0.3
    # Raw lidar is available for comparison. Leave it off by default so it
    # does not obscure the processed cloud from the Jetson.
    - Class: rviz_default_plugins/PointCloud2
      Name: Lidar
      Enabled: false
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /ouster/points
      Style: Flat Squares
      Size (m): 0.03
      Color Transformer: Intensity
      Channel Name: range
      Use rainbow: true
      Invert Rainbow: true
      Autocompute Intensity Bounds: true
    # The detector preserves the source frame and publishes packed RGB colors.
    # RViz uses TF to display the cloud in base_link without changing the topic.
    - Class: rviz_default_plugins/PointCloud2
      Name: Lidar edges
      Enabled: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /lidar_perception/edge_cloud
      Style: Points
      Size (Pixels): 3
      Color Transformer: RGB8
      Decay Time: 0
    # Lidar images (os_driver publishes them with the cloud). Signal and range
    # are on; tick reflectivity / near-IR in the Displays panel if needed.
    - Class: rviz_default_plugins/Image
      Name: Lidar signal
      Enabled: true
      Normalize Range: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /ouster/signal_image
    - Class: rviz_default_plugins/Image
      Name: Lidar range
      Enabled: true
      Normalize Range: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /ouster/range_image
    - Class: rviz_default_plugins/Image
      Name: Lidar reflectivity
      Enabled: false
      Normalize Range: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /ouster/reflec_image
    - Class: rviz_default_plugins/Image
      Name: Lidar near-IR
      Enabled: false
      Normalize Range: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /ouster/nearir_image
    # Cameras (Jetson, over the cable). jetson_bringup zed_cameras.launch.py.
    # Best effort so a slow link drops frames instead of backing up.
    - Class: rviz_default_plugins/Image
      Name: Front camera
      Enabled: true
      Normalize Range: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /zed_front/zed_node/rgb/color/rect/image
    - Class: rviz_default_plugins/Image
      Name: Left camera
      Enabled: true
      Normalize Range: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /zed_left/zed_node/rgb/color/rect/image
    - Class: rviz_default_plugins/Image
      Name: Rear camera
      Enabled: true
      Normalize Range: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /zed_rear/zed_node/rgb/color/rect/image
    - Class: rviz_default_plugins/Image
      Name: Right camera
      Enabled: true
      Normalize Range: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /zed_right/zed_node/rgb/color/rect/image
    # The annotated panorama is produced on the Jetson when both panorama and
    # edge detection are enabled. The original remains available below.
    - Class: rviz_default_plugins/Image
      Name: Panorama
      Enabled: true
      Normalize Range: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /panorama/edges
    - Class: rviz_default_plugins/Image
      Name: Panorama original
      Enabled: false
      Normalize Range: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /panorama/image
  Global Options:
    Fixed Frame: base_link
    Background Color: 118; 118; 118
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 12
      Pitch: 0.7
      Yaw: 2.4
      Focal Point:
        X: 0.3
        Y: 0
        Z: 0.3
Window Geometry:
  Height: 1000
  Width: 1600
