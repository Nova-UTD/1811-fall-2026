<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>obc_bringup</name>
  <version>0.0.0</version>
  <description>One-command bringup for the 1811 Karbon: the full stack (manual driving and teach and repeat through mode_manager), plus radar.</description>
  <maintainer email="k28adit@gmail.com">adit22</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>control</exec_depend>
  <exec_depend>joy</exec_depend>
  <exec_depend>localization</exec_depend>
  <exec_depend>mode_manager</exec_depend>
  <exec_depend>ouster_ros</exec_depend>
  <exec_depend>routing</exec_depend>
  <exec_depend>teleop_bridge</exec_depend>
  <exec_depend>umrr_ros2_driver</exec_depend>
  <exec_depend>vehicle_1811_description</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
