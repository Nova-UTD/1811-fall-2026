<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mode_manager</name>
  <version>0.0.0</version>
  <description>Gates /vehicle_command between the gamepad and pure pursuit:
    DISABLED / MANUAL / AUTONOMOUS switched by gamepad buttons, with a
    hold-to-drive deadman for AUTONOMOUS. Step A3 of
    docs/teach_and_repeat_plan.md.</description>
  <maintainer email="aarohnanoti@gmail.com">aarohCodes</maintainer>
  <license>TODO: License declaration</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>vehicle_msgs</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
