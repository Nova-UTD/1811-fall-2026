<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>camera_panorama</name>
  <version>0.0.0</version>
  <description>Stitches the four 1811 ZED X cameras into one 360-degree panorama
    (/panorama/image), using each camera's calibration and its pose from TF.
    Runs on the Jetson next to the cameras.</description>
  <maintainer email="aarohnanoti@gmail.com">aarohCodes</maintainer>
  <license>TODO: License declaration</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2_ros</depend>
  <exec_depend>python3-numpy</exec_depend>
  <!-- Optional: ~4x faster warping when present (it is on the Jetson). -->
  <exec_depend>python3-opencv</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
