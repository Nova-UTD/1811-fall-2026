<?xml version="1.0"?>
<!-- ROS package metadata and dependencies for the vehicle UI hub. -->
<package format="3">
  <name>vehicle_ui_hub</name>
  <version>0.1.0</version>
  <description>Vehicle dashboard with an embedded RViz view and calibration controls.</description>
  <maintainer email="k28adit@gmail.com">adit22</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>diagnostic_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>qt-base-dev</depend>
  <depend>rclcpp</depend>
  <depend>rviz_common</depend>
  <depend>rviz_rendering</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_msgs</depend>
  <depend>vehicle_msgs</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-pyqt5</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>
  <exec_depend>rosbag2</exec_depend>
  <exec_depend>rviz_default_plugins</exec_depend>
  <exec_depend>vehicle_1811_description</exec_depend>
  <test_depend>sensor_msgs_py</test_depend>
  <test_depend>python3-yaml</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
